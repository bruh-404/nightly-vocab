# ==============================================================================
# Nightly Vocab / LexiContext — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in real secrets before deploying.
# ==============================================================================

# --- Domain & Web Gateway ---
DOMAIN=vocab.example.com
SITE_URL=https://vocab.example.com

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=vocab.example.com,web,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://vocab.example.com
SECURE_SSL_REDIRECT=True

# --- PostgreSQL Database ---
POSTGRES_DB=lexicontext
POSTGRES_USER=lexi
POSTGRES_PASSWORD=replace-with-strong-db-password-minimum-16-chars
DATABASE_URL=postgres://lexi:replace-with-strong-db-password-minimum-16-chars@db:5432/lexicontext

# --- Cryptography / Secret Field Encryption ---
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=Zyk0_cNjhzLj0tmOXFDB241OWo7EIM-2ns-nJgz3jVg=

# --- Google OAuth Authentication ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: https://vocab.example.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional comma-separated list of allowed user emails (empty = anyone with Google account can sign up)
ALLOWED_EMAILS=

# --- Google Gemini AI (Shared Server Quota) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyYourSharedGeminiApiKeyHere
AI_MODEL=gemini-2.5-flash
AI_DAILY_CALL_LIMIT_PER_USER=30

# --- Telegram Bot ---
# Create via @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz_token
TELEGRAM_BOT_USERNAME=@YourVocabBot
# Random string for validating webhook requests from Telegram:
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret-token-32-chars

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
